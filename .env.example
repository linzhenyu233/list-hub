# Environment variable reference. Never put real secrets in this file.
# Copy this file to .env for local development, or configure the same names as
# operating-system environment variables. Real secrets must never be committed.

# WeChat Store: required
WX_APPID=
WX_SECRET=
WX_FREIGHT_TEMPLATE_ID=
WX_AFTER_SALE_ADDRESS_ID=

# Xiaohongshu: required
XHS_APP_ID=
XHS_APP_SECRET=
# 首次授权时把回调里的 code 填到 XHS_AUTH_CODE / 网页设置页提交一次，
# 之后由服务端 token_store.json 保存并自动续期；这三项切勿提交真实值。
XHS_ACCESS_TOKEN=
XHS_REFRESH_TOKEN=
XHS_AUTH_CODE=
# Optional custom token persistence path
XHS_TOKEN_FILE=C:\path\to\token_store.json

# Guanyi ERP: only required for Guanyi synchronization
GY_APPKEY=
GY_SECRET=
GY_SESSIONKEY=
GY_API_URL=http://api.guanyierp.com/rest/erp_open
XHS_BRAND_ID=
XHS_CATEGORY_ID=
XHS_SHIPPING_TEMPLATE_ID=
XHS_LOGISTICS_PLAN_ID=

# Backend service binding
WX_API_HOST=0.0.0.0
WX_API_PORT=8000
XHS_API_HOST=0.0.0.0
XHS_API_PORT=8010
BULK_API_HOST=0.0.0.0
BULK_API_PORT=8020
CORS_ORIGINS=http://localhost:5173

# Internal service addresses used by the batch service
WECHAT_API_BASE=http://127.0.0.1:8000
XHS_API_BASE=http://127.0.0.1:8010

# Batch publishing storage and concurrency
BULK_DB_FILE=C:\path\to\bulk_catalog.sqlite3
BULK_IMAGE_DIR=C:\path\to\images
BULK_WORKERS_PER_PLATFORM=2

# Huopai (货盘表) direct import — 只允许读取 HUOPAI_DIR 目录内的 .xlsx
# HUOPAI_PATH 为默认货盘表文件；HUOPAI_DIR 不填时自动取 HUOPAI_PATH 所在目录
HUOPAI_PATH=C:\path\to\共享-线上渠道货盘表（附库存）最新.xlsx
HUOPAI_DIR=C:\path\to\货盘目录

# Vue development server and proxy targets
VITE_DEV_PORT=5173
VITE_WECHAT_PROXY_TARGET=http://127.0.0.1:8000
VITE_XHS_PROXY_TARGET=http://127.0.0.1:8010
VITE_BULK_PROXY_TARGET=http://127.0.0.1:8020
