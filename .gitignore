# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
env/

# ---- Node / 前端 ----
node_modules/
dist/
.vite/

# ---- 环境变量与密钥（真值放 .env，切勿提交）----
.env
.env.local
.env.*.local
# 多店铺注册表（含各店 appid/secret/token，严禁提交；含 .bak 等备份变体）
shops.json*
!shops.example.json
**/token_store.json
# 小红书按店铺分 token 文件（xhs/tokens/<shop_id>.json）
xhs/tokens/
*.pem
*.key
*.p12
*.pfx
*.crt

# ---- 运行时数据 ----
# 批量中台的 SQLite 目录库(含 WAL 模式产生的 -wal / -shm 旁挂文件)
*.sqlite3
*.sqlite3-*
*.sqlite
*.db
# upload_images.py 的输出文件（单店默认名 + 按店分文件名）
uploaded_images.json
uploaded_images.txt
uploaded_images_*.json
uploaded_images_*.txt
# 批量导入的图片缓存目录（bulk_api.py 的 IMAGE_DIR）
images/
**/images/
# 管易云同步产物（含平台 SKU 绑定映射，敏感）
**/guanyi_xhs_mapping.json
**/guanyi_sync_state.json
# 预留：第二档会把所有运行时数据统一收进 data/
data/
uploads/
tmp/
temp/

# ---- IDE / 工具缓存 ----
.idea/
.vscode/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ---- 日志 ----
*.log
# 服务重定向输出(bulk_api/_svc.err、_worker.out 等)
*.err
*.out
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 临时 / 测试产物 ----
*.xlsx
*.xls
*.csv
*.zip
*.crdownload
test_output/
screenshots/
.DS_Store
Thumbs.db
*.pid
*.lock

