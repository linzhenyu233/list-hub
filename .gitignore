# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
env/

# ---- Node / 前端 ----
node_modules/
dist/
.vite/

# ---- 环境变量与密钥（真值放 .env，切勿提交）----
.env
.env.local
.env.*.local
# 多店铺注册表（含各店 appid/secret/token，严禁提交；含 .bak 等备份变体）
shops.json*
!shops.example.json
**/token_store.json
# 小红书按店铺分 token 文件（xhs/tokens/<shop_id>.json）
xhs/tokens/
# 有赞按店铺分 token 文件（youzan/tokens/<shop_id>.json，含真实 access_token 与 kdt_id）
youzan/tokens/
*.pem
*.key
*.p12
*.pfx
*.crt

# ---- 运行时数据 ----
# 批量中台的 SQLite 目录库(含 WAL 模式产生的 -wal / -shm 旁挂文件)
*.sqlite3
*.sqlite3-*
*.sqlite
*.db
# upload_images.py 的输出文件（单店默认名 + 按店分文件名）
uploaded_images.json
uploaded_images.txt
uploaded_images_*.json
uploaded_images_*.txt
# 批量导入的图片缓存目录（bulk_api.py 的 IMAGE_DIR）
images/
**/images/
# 批次来源记录 + 货盘表备份（bulk_api/_sources）：运行时数据、含本机绝对路径，不应进仓库
bulk_api/_sources/
# 商品图 URL 缓存（bulk_api/_cache_product_images.json）：运行时产物，含真实商品 ID 与图床链接
bulk_api/_cache_product_images.json
# 管易云同步产物（含平台 SKU 绑定映射，敏感）
**/guanyi_xhs_mapping.json
**/guanyi_sync_state.json
# mock 录制产物（MOCK_RECORD=1 时把真实响应录进 <平台>/fixtures/_recorded/）：
# 已自动脱敏密钥，但仍含真实商品/业务数据，不进仓库；要长期保留的请人工挑出来放进 fixtures/ 顶层
**/fixtures/_recorded/
# 预留：第二档会把所有运行时数据统一收进 data/
data/
uploads/
tmp/
temp/

# ---- IDE / 工具缓存 ----
.idea/
.vscode/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ---- 日志 ----
*.log
# 服务重定向输出(bulk_api/_svc.err、_worker.out 等)
*.err
*.out
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 临时 / 测试产物 ----
*.xlsx
*.xls
*.csv
*.zip
*.crdownload
test_output/
screenshots/
.DS_Store
Thumbs.db
*.pid
*.lock

# ---- 工具目录 / 临时产物（2026-09-16 收尾补充）----
.codebuddy/
ui-preview/
generated-images/
# 设计/UI 工具生成的过程截图（ardot 等），只在本机看，不进仓库
.ardot_shots/
.screens/
# 软著登记材料（源程序 PDF / 用户操作手册 / 说明书插图）：内部报送材料，不进公开仓库
软著登记材料/
